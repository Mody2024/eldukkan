# Copy this to .env.local for local dev, and set the same keys in
# Vercel → Project Settings → Environment Variables for production.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Private admin dashboard path. Pick your own unguessable slug (not the
# example below) and don't share it outside your admin team. This is a
# deterrent against casual discovery, NOT the actual access control —
# Supabase Auth + the RLS policies in supabase/migrations/ are what
# actually gate the data. Changing this value changes the admin URL.
VITE_ADMIN_PATH=ops-console-7f2k9x
